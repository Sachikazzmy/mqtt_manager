# Compose reads this file after it is copied to .env. No passwords belong here.
MQTT_BIND_ADDRESS=0.0.0.0
MQTT_TLS_PORT=8883
MQTT_WS_PORT=9001
MQTT_CERT_DNS_NAME=mqtt.web4sachika.asia
MQTT_CERT_IP=10.0.0.113
MQTT_QUEUE_SIZE=128
# Maximum number of segment metric identities per device (1-100).
MAX_METRICS_PER_DEVICE=10
# Independent deadline for the startup database migrations.
MIGRATION_TIMEOUT=15m
